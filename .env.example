# Server & Port Configuration
PORT=3000

# Authentication & Security
JWT_SECRET="replace-with-a-long-random-secret-in-production"

# Initial Admin Account (Seeded on first startup if no admin exists)
ADMIN_EMAIL="admin@prayagtechno.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@Prayag2026!"

# PostgreSQL Database Connection String (e.g. Neon, Render PostgreSQL, Supabase, AWS RDS, or local)
# Format: postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/database

# Application Base URL (e.g. https://your-app.onrender.com or https://prayagtechno.com)
APP_URL="https://prayagtechno.com"
